{
  "name": "dsh-plugin-llm-verifier",
  "version": "0.8.1",
  "description": "LLM-as-a-Verifier for DeepSeek Harness (dsh): continuous reward signals via select / compare / track, with stricter reference-aligned review and corrections",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/engine.test.js"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "llm-as-a-verifier",
    "verifier",
    "reward-model",
    "best-of-n"
  ],
  "author": "Ivan Parfenchuk",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GMH13552/dsh-longrun-suite.git"
  },
  "homepage": "https://github.com/GMH13552/dsh-longrun-suite#readme",
  "bugs": {
    "url": "https://github.com/GMH13552/dsh-longrun-suite/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  }
}
